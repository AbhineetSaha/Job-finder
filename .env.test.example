# Copy to .env.test and point DATABASE_URL at a scratch database.
# EMAIL_MODE must never be "production" here — the test bootstrap aborts if it is.
NODE_ENV=test
DATABASE_URL=postgres://postgres@127.0.0.1:5432/outreach_test
SESSION_SECRET=test-only-session-secret-at-least-32-chars-long
EMAIL_MODE=mock
EMAIL_PROVIDER=mock
EMAIL_WEBHOOK_SECRET=test-webhook-secret-value
MIN_SEND_DELAY_SECONDS=0
MAX_SEND_DELAY_SECONDS=0
LOG_LEVEL=error
