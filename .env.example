# =============================================================================
# Outreach — environment configuration
# =============================================================================
# Copy to .env and fill in. Never commit .env.
#
# NOTE: There are intentionally NO AI-related variables in this file.
# This application has no AI API, no AI SDK, and no LLM runtime dependency.
# A test (tests/unit/no-ai-dependency.test.ts) fails the build if any appear.
# =============================================================================

# --- Database ----------------------------------------------------------------
# PostgreSQL 9.5+ (needs FOR UPDATE SKIP LOCKED). Server-only, never exposed.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/outreach_dev

# --- Application -------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# Session cookie signing/derivation secret. Minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating this invalidates every existing session.
SESSION_SECRET=change-me-to-at-least-32-random-characters

# --- Email mode --------------------------------------------------------------
# "mock"       — nothing leaves the machine. Messages are stored; delivery,
#                bounces and replies can be simulated. THIS IS THE DEFAULT.
# "production" — real sending. Requires EMAIL_PROVIDER, EMAIL_API_KEY,
#                EMAIL_FROM, and a configured postal address in Settings.
#
# Any value other than these two fails startup. Sending real email is opt-in,
# explicit, and additionally requires per-message human approval.
EMAIL_MODE=mock

# --- Email provider (only read when EMAIL_MODE=production) -------------------
# Supported: mock | resend
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Shared secret used to verify inbound provider webhooks (bounces, replies).
# Webhook routes reject every request if this is unset.
EMAIL_WEBHOOK_SECRET=
# Maximum age of a signed webhook timestamp, in seconds.
WEBHOOK_TOLERANCE_SECONDS=300

# --- Sending limits ----------------------------------------------------------
# Defaults only. The per-user `settings` row overrides these at runtime so
# limits can be tightened without a redeploy. Deliberately conservative.
DAILY_SEND_LIMIT=20
HOURLY_SEND_LIMIT=5
PER_DOMAIN_SEND_LIMIT=2
MIN_SEND_DELAY_SECONDS=90
MAX_SEND_DELAY_SECONDS=600

# --- Scheduling --------------------------------------------------------------
# Fallback timezone when a prospect's timezone is unknown and the campaign
# does not set one. Must be a valid IANA identifier.
DEFAULT_TIMEZONE=America/New_York

# Master switch for follow-up steps. When false, only step 0 is ever enqueued.
FOLLOWUP_ENABLED=true

# --- Worker ------------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=5
WORKER_VISIBILITY_TIMEOUT_SECONDS=300
JOB_MAX_ATTEMPTS=5

# --- Logging -----------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
